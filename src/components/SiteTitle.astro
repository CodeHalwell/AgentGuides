---
// Header mark: the compact element tile (symbol only; metadata drops below 64px).
const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title sl-flex">
  <span class="mini-tile" aria-hidden="true">Ag</span>
  <span class="title-text" translate="no">{siteTitle}</span>
</a>

<style>
  .site-title {
    align-items: center;
    gap: 0.75rem;
    font-size: var(--sl-text-h4);
    color: var(--tx);
    text-decoration: none;
    white-space: nowrap;
    min-width: 0;
  }
  .mini-tile {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    flex: none;
    background: var(--bg);
    color: var(--tx);
    border: 2px solid var(--tx);
    box-shadow: 3px 3px 0 var(--ac);
    font-family: var(--brand-font-display);
    font-size: 1.05rem;
    line-height: 1;
  }
  .title-text {
    overflow: hidden;
    font-family: var(--sl-font-mono);
    font-size: 0.8rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
</style>
