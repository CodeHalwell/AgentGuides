---
// Page header.
// - Guide landing pages: the "element detail" layout (large filled tile, title, lead,
//   and a ruled metadata row: group, current version, the languages it bonds with).
// - Other guide pages: the notebook-article layout (element chips, title, lead).
// - The home page renders its own h1 in the periodic table, so nothing here.
import { getCollection } from 'astro:content';
import { frameworks, categoryGroup, languageSymbol } from '../data/frameworks';

// Starlight's PAGE_TITLE_ID (not a public export); skip links and the TOC target it.
const PAGE_TITLE_ID = '_top';
const { entry, id } = Astro.locals.starlightRoute;
// Starlight gives the home page an empty id.
const isHome = id === '' || id === 'index';
const path = isHome ? '/' : `/${id}/`;

// The framework whose guide this page belongs to: the longest matching href,
// falling back to the guide folder for pages outside a language subfolder.
const longest = (list: typeof frameworks) => [...list].sort((a, b) => b.href.length - a.href.length)[0];
const framework =
  longest(frameworks.filter((f) => path.startsWith(f.href))) ??
  frameworks.find((f) => path.startsWith(f.href.replace(/(python|typescript)\/$/, '')));

const segment = id.split('/')[1];
const folderLang: Record<string, string> = { python: 'Py', typescript: 'Ts', dotnet: 'C#', go: 'Go', rust: 'Rs' };
const language =
  folderLang[segment] ??
  (framework?.languages.length === 1 ? languageSymbol[framework.languages[0]] : undefined);

const isLanding = framework && path === framework.href;
const group = framework ? categoryGroup[framework.category] : 'ink';
const number = framework ? frameworks.indexOf(framework) + 1 : 0;
const pageCount = isLanding
  ? (await getCollection('docs')).filter((d) => `/${d.id}/`.startsWith(framework.href)).length
  : 0;
---

{
  isHome ? null : isLanding ? (
    <div class="element-head">
      <div class="big-tile" data-group={group} aria-hidden="true">
        <div class="row">
          <span>{number}</span>
          <span>{pageCount} pages</span>
        </div>
        <span class="sym">{framework.symbol}</span>
        <span class="foot">
          {framework.name.replace(/\s*\((Python|TypeScript)\)$/, '')} · {framework.category}
        </span>
      </div>
      <div class="info">
        <h1 id={PAGE_TITLE_ID}>{entry.data.title}</h1>
        {entry.data.description && <p class="lead">{entry.data.description}</p>}
        <div class="meta">
          <div>
            <span class="k">Group</span>
            <span class="v">{framework.category}</span>
          </div>
          <div>
            <span class="k">Current version</span>
            <span class="v mono">{framework.version}</span>
          </div>
          <div>
            <span class="k">Bonds with</span>
            <span class="v chips">
              {framework.languages.map((l) => (
                <span class="chip" data-group="cobalt" title={l}>
                  {languageSymbol[l]}
                </span>
              ))}
            </span>
          </div>
        </div>
      </div>
    </div>
  ) : (
    <div class="page-head">
      {framework && (
        <div class="chips" aria-label={`${framework.name}${language ? `, ${language}` : ''}`}>
          <span class="chip" data-group={group} title={framework.name}>
            {framework.symbol}
          </span>
          {language && (
            <span class="chip" data-group="cobalt">
              {language}
            </span>
          )}
        </div>
      )}
      <h1 id={PAGE_TITLE_ID}>{entry.data.title}</h1>
      {entry.data.description && <p class="lead">{entry.data.description}</p>}
    </div>
  )
}

<style>
  .page-head {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 1rem;
  }
  h1 {
    margin: 0;
    font-family: var(--brand-font-display);
    font-weight: 400;
    font-size: clamp(2.2rem, 4.5vw, 3.4rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
    text-wrap: balance;
    color: var(--tx);
  }
  .lead {
    margin: 0;
    font-family: var(--brand-font-display);
    font-size: clamp(1.15rem, 2vw, 1.4rem);
    line-height: 1.4;
    color: var(--mu);
    max-width: 40em;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  /* Element detail */
  .element-head {
    display: grid;
    grid-template-columns: minmax(0, 15rem) minmax(0, 1fr);
    gap: 2.5rem;
    align-items: start;
    margin-top: 1rem;
  }
  @media (max-width: 50rem) {
    .element-head {
      grid-template-columns: 1fr;
    }
    .big-tile {
      max-width: 13rem;
    }
  }
  .big-tile {
    aspect-ratio: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 1rem 1.1rem;
    border: 4px solid var(--tx);
    box-shadow: 12px 12px 0 var(--tx);
    font-family: var(--sl-font-mono);
  }
  .big-tile[data-group='oxide'] { background: var(--ac); color: var(--onac); }
  .big-tile[data-group='verdigris'] { background: var(--vd); color: var(--onvd); }
  .big-tile[data-group='sulfur'] { background: var(--su); color: var(--brand-ink); }
  .big-tile[data-group='permanganate'] { background: var(--pm); color: var(--onpm); }
  .big-tile[data-group='ink'] { background: var(--tx); color: var(--bg); box-shadow: 12px 12px 0 var(--ac); }
  .big-tile .row {
    display: flex;
    justify-content: space-between;
    font-size: 0.9rem;
  }
  .big-tile .sym {
    font-family: var(--brand-font-display);
    font-size: clamp(5rem, 9vw, 7.5rem);
    line-height: 0.8;
    letter-spacing: -0.04em;
  }
  .big-tile .foot {
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .info {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    border-top: 2px solid var(--tx);
  }
  .meta > div {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 0.8rem 0;
    border-bottom: 1px solid var(--rl);
  }
  .meta .k {
    font-family: var(--sl-font-mono);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--mu);
  }
  .meta .v {
    font-weight: 600;
  }
  .meta .mono {
    font-family: var(--sl-font-mono);
    font-weight: 400;
    font-size: 0.85rem;
  }
</style>
